<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Concorde</RootNamespace>
    <AssemblyName>Concorde</AssemblyName>
    <Version>0.5.11</Version>
    <Product>Concorde</Product>
    <ApplicationIcon>concorde.ico</ApplicationIcon>
    <!-- O pacote do WebView2 traz também a versão WPF, que não usamos (só gera aviso) -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NetMQ" Version="4.0.4.5" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <!-- Versões corrigidas de dependências antigas que vinham por tabela (alertas de segurança GHSA-7jgj / GHSA-cmhx). -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="concorde.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Os testes automáticos (src/ConcordeDesktop.Testes) podem chamar as funções "internal" (ex.: a trava de links do bot de música). -->
  <ItemGroup>
    <InternalsVisibleTo Include="ConcordeDesktop.Testes" />
  </ItemGroup>

</Project>
